---
# Red Hat Ansible Collection Certification .ansible-lint file
# Taken from:
# https://github.com/ansible-collections/partner-certification-requirements
profile: production

exclude_paths:
  - tests/integration
  - tests/unit
  - extensions/molecule
  - changelogs
  - docs
  - .ansible
  - .github
  - validate

warn_list:
  - no-log-password

# netbox.netbox is a galaxy.yml dependency, but the certification importer lints
# without installing dependencies. Stubs let syntax-check resolve these modules.
mock_modules:
  - netbox.netbox.netbox_config_context
  - netbox.netbox.netbox_console_server_port
  - netbox.netbox.netbox_custom_field
  - netbox.netbox.netbox_custom_link
  - netbox.netbox.netbox_device
  - netbox.netbox.netbox_ip_address
  - netbox.netbox.netbox_manufacturer
  - netbox.netbox.netbox_platform
